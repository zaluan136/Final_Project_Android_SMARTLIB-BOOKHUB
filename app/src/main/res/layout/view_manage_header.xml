<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <LinearLayout android:id="@+id/manage_reader_guard"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="6dp" android:paddingBottom="8dp" android:text="@string/management_space"
            android:textColor="@color/ink" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="6dp" android:paddingBottom="8dp" android:lineSpacingExtra="3dp"
            android:text="@string/management_reader_guard" android:textColor="@color/muted" android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/manage_staff_content"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:layout_marginBottom="4dp"
            android:background="@drawable/panel" android:orientation="vertical" android:padding="@dimen/card_padding">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="6dp" android:paddingBottom="8dp" android:text="@string/library_overview"
                android:textColor="@color/ink" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/manage_summary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp"
                android:lineSpacingExtra="3dp" android:textColor="@color/muted" android:textSize="17sp" />
            <TextView android:id="@+id/manage_fees" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp"
                android:lineSpacingExtra="3dp" android:textColor="@color/muted" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/manage_add_book"
                style="?attr/materialButtonTonalStyle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" android:minHeight="48dp"
                android:text="@string/add_book" app:cornerRadius="20dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="6dp" android:paddingBottom="8dp" android:text="@string/loan_desk"
            android:textColor="@color/ink" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="6dp" android:paddingBottom="8dp" android:lineSpacingExtra="3dp"
            android:text="@string/loan_desk_description" android:textColor="@color/muted" android:textSize="14sp" />
        <LinearLayout android:id="@+id/manage_empty" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="4dp"
            android:background="@drawable/panel" android:orientation="vertical" android:padding="@dimen/card_padding">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="6dp" android:paddingBottom="8dp" android:text="@string/no_desk_loans"
                android:textColor="@color/ink" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="6dp" android:paddingBottom="8dp" android:lineSpacingExtra="3dp"
                android:text="@string/no_desk_loans_description" android:textColor="@color/muted" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
