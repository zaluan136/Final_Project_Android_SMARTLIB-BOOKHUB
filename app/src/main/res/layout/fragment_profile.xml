<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingHorizontal="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="6dp" android:paddingBottom="8dp"
            android:text="@string/library_information" android:textColor="@color/ink"
            android:textSize="26sp" android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_firebase"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_marginTop="8dp" android:layout_marginBottom="4dp"
            android:text="@string/connect_firebase" app:cornerRadius="20dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:layout_marginBottom="4dp"
            android:background="@drawable/panel" android:orientation="vertical"
            android:padding="@dimen/card_padding">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="6dp" android:paddingBottom="8dp"
                android:text="@string/borrowing_rules" android:textColor="@color/ink"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/profile_rules"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="6dp" android:paddingBottom="8dp" android:lineSpacingExtra="3dp"
                android:textColor="@color/muted" android:textSize="15sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/profile_edit_rules"
                style="?attr/materialButtonTonalStyle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:layout_marginTop="8dp" android:layout_marginBottom="4dp"
                android:text="@string/edit_rules" android:visibility="gone" app:cornerRadius="20dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:layout_marginBottom="4dp"
            android:background="@drawable/panel" android:orientation="vertical"
            android:padding="@dimen/card_padding">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="6dp" android:paddingBottom="8dp"
                android:text="@string/find_books_by_shelf" android:textColor="@color/ink"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="6dp" android:paddingBottom="8dp" android:lineSpacingExtra="3dp"
                android:text="@string/library_shelf_map" android:textColor="@color/muted" android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:layout_marginBottom="4dp"
            android:background="@drawable/panel" android:orientation="vertical"
            android:padding="@dimen/card_padding">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="6dp" android:paddingBottom="8dp"
                android:text="@string/demo_about_title" android:textColor="@color/ink"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="6dp" android:paddingBottom="8dp" android:lineSpacingExtra="3dp"
                android:text="@string/demo_about_details" android:textColor="@color/muted" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
