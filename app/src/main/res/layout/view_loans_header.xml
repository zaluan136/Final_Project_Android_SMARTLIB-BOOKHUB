<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="6dp" android:paddingBottom="8dp" android:text="@string/loans"
        android:textColor="@color/ink" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="6dp" android:paddingBottom="8dp" android:lineSpacingExtra="3dp"
        android:text="@string/loans_description" android:textColor="@color/muted" android:textSize="14sp" />
    <LinearLayout android:id="@+id/loans_empty"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:layout_marginBottom="4dp"
        android:background="@drawable/panel" android:orientation="vertical"
        android:padding="@dimen/card_padding">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="6dp" android:paddingBottom="8dp"
            android:text="@string/no_loans" android:textColor="@color/ink"
            android:textSize="21sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="6dp" android:paddingBottom="8dp" android:lineSpacingExtra="3dp"
            android:text="@string/no_loans_description" android:textColor="@color/muted" android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/loans_explore"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="4dp" android:minHeight="48dp"
            android:text="@string/explore_books" app:cornerRadius="20dp" />
    </LinearLayout>
</LinearLayout>
